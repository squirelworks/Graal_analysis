# fzk v3: Escape only at the very end (2.x Escape = modal "quit Graal?" dialog; a later space confirms it). No Escape after F-keys.
# fzk v2 (2026-11-20): kx2.sh (rep/hold work), plus K14 Ctrl+letter sweep, K15 single-key sweep, K16 dialog keys last.
# fz: key/chat input fuzz. Vars: D (X display), LV (start level). C>S per mark window is the observer (c2swin.py).
waitsession 240
wait s2c 9 90
sleep 12
shot 00-base
mark K01 tab-open-type-return
sh sh $HOME/fzk/kx2.sh {D} key Tab
sleep 0.5
sh sh $HOME/fzk/kx2.sh {D} type 'fzhello1'
sh sh $HOME/fzk/kx2.sh {D} key Return
sleep 1.5
shot k01
mark K02 type-return
sh sh $HOME/fzk/kx2.sh {D} type 'fzhello2'
sh sh $HOME/fzk/kx2.sh {D} key Return
sleep 1.5
shot k02
mark K03 long-300
sh sh $HOME/fzk/kx2.sh {D} key Tab
sh sh $HOME/fzk/kx2.sh {D} type ''
sh sh $HOME/fzk/kx2.sh {D} key Return
sleep 2
shot k03
mark K04 long-300-noTab
sh sh $HOME/fzk/kx2.sh {D} type ''
sh sh $HOME/fzk/kx2.sh {D} key Return
sleep 2
shot k04
mark K05 hashcodes
sh sh $HOME/fzk/kx2.sh {D} key Tab
sh sh $HOME/fzk/kx2.sh {D} type '#c#n#v(playerrupees)#s(x)#g#m#1#8#a#e#f#K(65)#w#p(0)#P1'
sh sh $HOME/fzk/kx2.sh {D} key Return
sleep 2
shot k05
mark K06 highbytes
sh sh $HOME/fzk/kx2.sh {D} key Tab
sh sh $HOME/fzk/kx2.sh {D} type 'fzäöüÿ§°'
sh sh $HOME/fzk/kx2.sh {D} key Return
sleep 2
shot k06
mark K07 chat-open-then-ctrl-fkeys
sh sh $HOME/fzk/kx2.sh {D} key Tab
sh sh $HOME/fzk/kx2.sh {D} type 'fzopen'
sh sh $HOME/fzk/kx2.sh {D} key ctrl+a ctrl+c ctrl+v
sleep 2
shot k07
mark K08 rapid-a-x200
sh sh $HOME/fzk/kx2.sh {D} rep 200 a
sleep 2
shot k08
mark K09 rapid-space-x50
sh sh $HOME/fzk/kx2.sh {D} rep 50 space
sleep 3
shot k09
mark K10 hold-right-across-warp
sh sh -c "$HOME/fzk/kx2.sh {D} hold Right 3 &"
sleep 1
s2c 14 c:60 c:60 t:{LV}
sleep 4
shot k10
mark K11 all-mods-letters
sh sh $HOME/fzk/kx2.sh {D} key ctrl+alt+a shift+ctrl+a alt+shift+a
sh sh $HOME/fzk/kx2.sh {D} key ctrl+alt+s shift+ctrl+s alt+shift+s
sh sh $HOME/fzk/kx2.sh {D} key ctrl+alt+d shift+ctrl+d alt+shift+d
sh sh $HOME/fzk/kx2.sh {D} key ctrl+alt+q shift+ctrl+q alt+shift+q
sh sh $HOME/fzk/kx2.sh {D} key ctrl+alt+w shift+ctrl+w alt+shift+w
sh sh $HOME/fzk/kx2.sh {D} key ctrl+alt+e shift+ctrl+e alt+shift+e
sh sh $HOME/fzk/kx2.sh {D} key ctrl+alt+z shift+ctrl+z alt+shift+z
sh sh $HOME/fzk/kx2.sh {D} key ctrl+alt+x shift+ctrl+x alt+shift+x
sh sh $HOME/fzk/kx2.sh {D} key ctrl+alt+c shift+ctrl+c alt+shift+c
sleep 2
shot k11
mark K12 slashcmds
sh sh $HOME/fzk/kx2.sh {D} key Tab
sh sh $HOME/fzk/kx2.sh {D} type '/help'
sh sh $HOME/fzk/kx2.sh {D} key Return
sleep 1
sh sh $HOME/fzk/kx2.sh {D} key Tab
sh sh $HOME/fzk/kx2.sh {D} type '/sethead fzh.png'
sh sh $HOME/fzk/kx2.sh {D} key Return
sleep 1
sh sh $HOME/fzk/kx2.sh {D} key Tab
sh sh $HOME/fzk/kx2.sh {D} type '/setbody fzb.png'
sh sh $HOME/fzk/kx2.sh {D} key Return
sleep 1
sh sh $HOME/fzk/kx2.sh {D} key Tab
sh sh $HOME/fzk/kx2.sh {D} type '/setnick fz'
sh sh $HOME/fzk/kx2.sh {D} key Return
sleep 1
sh sh $HOME/fzk/kx2.sh {D} key Tab
sh sh $HOME/fzk/kx2.sh {D} type '/toall fz'
sh sh $HOME/fzk/kx2.sh {D} key Return
sleep 1
sh sh $HOME/fzk/kx2.sh {D} key Tab
sh sh $HOME/fzk/kx2.sh {D} type '/showkills'
sh sh $HOME/fzk/kx2.sh {D} key Return
sleep 1
sleep 2
shot k12

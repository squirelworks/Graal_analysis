  temp.d = temp.o.distortTime;
  temp.o.distortTime = 0.5;
  temp.w = temp.o.distortTime;
  temp.o.distortTime = "zz";
  temp.j = temp.o.distortTime;
  temp.o.distortTime = temp.d;
  cf("WaterBlock.distortTime", "d=" @ temp.d @ "|w=" @ temp.w @ "|j=" @ temp.j);
  temp.d = temp.o.shoreDepth;
  temp.o.shoreDepth = 0.5;
  temp.w = temp.o.shoreDepth;
  temp.o.shoreDepth = "zz";
  temp.j = temp.o.shoreDepth;
  temp.o.shoreDepth = temp.d;
  cf("WaterBlock.shoreDepth", "d=" @ temp.d @ "|w=" @ temp.w @ "|j=" @ temp.j);
  temp.d = temp.o.depthGradient;
  temp.o.depthGradient = 0.5;
  temp.w = temp.o.depthGradient;
  temp.o.depthGradient = "zz";
  temp.j = temp.o.depthGradient;
  temp.o.depthGradient = temp.d;
  cf("WaterBlock.depthGradient", "d=" @ temp.d @ "|w=" @ temp.w @ "|j=" @ temp.j);
  temp.d = temp.o.minAlpha;
  temp.o.minAlpha = 0.5;
  temp.w = temp.o.minAlpha;
  temp.o.minAlpha = "zz";
  temp.j = temp.o.minAlpha;
  temp.o.minAlpha = temp.d;
  cf("WaterBlock.minAlpha", "d=" @ temp.d @ "|w=" @ temp.w @ "|j=" @ temp.j);
  temp.d = temp.o.maxAlpha;
  temp.o.maxAlpha = 0.5;
  temp.w = temp.o.maxAlpha;
  temp.o.maxAlpha = "zz";
  temp.j = temp.o.maxAlpha;
  temp.o.maxAlpha = temp.d;
  cf("WaterBlock.maxAlpha", "d=" @ temp.d @ "|w=" @ temp.w @ "|j=" @ temp.j);
  temp.d = temp.o.removeWetEdges;
  temp.o.removeWetEdges = true;
  temp.w = temp.o.removeWetEdges;
  temp.o.removeWetEdges = "zz";
  temp.j = temp.o.removeWetEdges;
  temp.o.removeWetEdges = temp.d;
  cf("WaterBlock.removeWetEdges", "d=" @ temp.d @ "|w=" @ temp.w @ "|j=" @ temp.j);
  temp.d = temp.o.specularColor;
  temp.n = temp.d.tokenize().size();
  if (temp.n == 3) temp.v = "1 2 3";
  else if (temp.n == 4) temp.v = "0.1 0.2 0.3 1";
  else if (temp.n == 6) temp.v = "-1 -2 -3 1 2 3";
  else if (temp.n == 7) temp.v = "1 2 3 0 0 1 0";
  else temp.v = "conf";
  temp.o.specularColor = temp.v;
  temp.w = temp.o.specularColor;
  cf("WaterBlock.specularColor", "d=" @ temp.d @ "|w=" @ temp.w);
  temp.d = temp.o.specularPower;
  temp.o.specularPower = 0.5;
  temp.w = temp.o.specularPower;
  temp.o.specularPower = "zz";
  temp.j = temp.o.specularPower;
  temp.o.specularPower = temp.d;
  cf("WaterBlock.specularPower", "d=" @ temp.d @ "|w=" @ temp.w @ "|j=" @ temp.j);
}
function ov(o) {
  if (o == NULL) return "null";
  return "obj:" @ o.name;
}
function cf(k, v) {
  triggerserver("gui", "ConfProbe", "cf", k, v);
}

function s_ActionMap() {
  cf("at", "ActionMap");
  temp.o = new ActionMap("sw_actionmap");
  temp.how = "new";
  if (temp.o == NULL) temp.how = "none";
  cf("ActionMap.@inst", temp.how @ "|" @ temp.o.objecttype());
  if (temp.o == NULL) return;
  temp.o.bind("keyboard", "f9", "conf_bind");
  cf("ActionMap.bind", "r=");
  temp.r = temp.o.getBinding("conf_bind");
  cf("ActionMap.getBinding", "r=" @ temp.r);
  temp.r = temp.o.getCommand("keyboard", "f9");
  cf("ActionMap.getCommand", "r=" @ temp.r);
  temp.r = temp.o.load();
  cf("ActionMap.load", "r=" @ temp.r);
  temp.o.pop();
  cf("ActionMap.pop", "r=");
  temp.o.push();
  cf("ActionMap.push", "r=");
  temp.o.save();
  cf("ActionMap.save", "r=");
  temp.o.unbind("keyboard", "f9");
  cf("ActionMap.unbind", "r=");
}
function ov(o) {
  if (o == NULL) return "null";
  return "obj:" @ o.name;
}
function cf(k, v) {
  triggerserver("gui", "ConfProbe", "cf", k, v);
}

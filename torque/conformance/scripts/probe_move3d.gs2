// Conformance probe (T3D-125): move3d(string,num,int) alone on the player's
// own object (world `movetype list`); reports the position before and after.
//#CLIENTSIDE
function onCreated() {
  setTimer(5);
}
function onTimeout() {
  this.n++;
  if (this.n == 1) {
    cf("pos1", player.position);
    player.move3d("0 2 1", 1, 0);
    cf("move3d_called", "1");
    setTimer(1);
  } else if (this.n < 5) {
    cf("pos" @ (this.n), player.position);
    setTimer(1);
  }
}
function cf(k, v) {
  triggerserver("gui", "ConfProbe", "cf", k, v);
}

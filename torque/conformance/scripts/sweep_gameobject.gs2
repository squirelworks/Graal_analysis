  temp.r = temp.o.getdropz("0 0 50");
  cf("GameObject.getdropz", "r=" @ temp.r);
  temp.r = temp.o.getInteriorObject();
  cf("GameObject.getInteriorObject", "r=" @ ov(temp.r));
  temp.r = temp.o.getMountedObject(1);
  cf("GameObject.getMountedObject", "r=" @ ov(temp.r));
  temp.r = temp.o.getMountedObjectCount();
  cf("GameObject.getMountedObjectCount", "r=" @ temp.r);
  temp.r = temp.o.getMountedObjectNode(1);
  cf("GameObject.getMountedObjectNode", "r=" @ temp.r);
  temp.r = temp.o.getMountNodeObject(1);
  cf("GameObject.getMountNodeObject", "r=" @ ov(temp.r));
  temp.r = temp.o.getMountTransform(1);
  cf("GameObject.getMountTransform", "r=" @ temp.r);
  temp.r = temp.o.getMountPosition(1);
  cf("GameObject.getMountPosition", "r=" @ temp.r);
  temp.r = temp.o.getNodeTransform("1 2 3");
  cf("GameObject.getNodeTransform", "r=" @ temp.r);
  temp.r = temp.o.getNodePosition("1 2 3");
  cf("GameObject.getNodePosition", "r=" @ temp.r);
  temp.r = temp.o.getObjectMount();
  cf("GameObject.getObjectMount", "r=" @ ov(temp.r));
  temp.o.hideimg(1);
  cf("GameObject.hideimg", "r=");
  temp.o.hideimgs(1, 1);
  cf("GameObject.hideimgs", "r=");
  temp.r = temp.o.isDrawn();
  cf("GameObject.isDrawn", "r=" @ temp.r);
  temp.r = temp.o.isInInterior();
  cf("GameObject.isInInterior", "r=" @ temp.r);
  temp.r = temp.o.isMounted();
  cf("GameObject.isMounted", "r=" @ temp.r);
  temp.r = temp.o.mountObject(this.go2, 1);
  cf("GameObject.mountObject", "r=" @ temp.r);
  temp.o.setDirection("1 2 3");
  cf("GameObject.setDirection", "r=");
  temp.o.unmount();
  cf("GameObject.unmount", "r=");
  temp.r = temp.o.unmountObject(this.go2);
  cf("GameObject.unmountObject", "r=" @ temp.r);
}
function s_Camera() {
  cf("at", "Camera");
  temp.o = new Camera("sw_camera");
  temp.how = "new";
  if (temp.o == NULL) {
    temp.o = ServerConnection.camera;
    temp.how = "ServerConnection.camera";
  }
  if (temp.o == NULL) {
    temp.o = player.camera;
    temp.how = "player.camera";
  }
  if (temp.o == NULL) temp.how = "none";
  cf("Camera.@inst", temp.how @ "|" @ temp.o.objecttype());
  if (temp.o == NULL) return;
  temp.d = temp.o.cameramode;
  temp.n = temp.d.tokenize().size();
  if (temp.n == 3) temp.v = "1 2 3";
  else if (temp.n == 4) temp.v = "0.1 0.2 0.3 1";
  else if (temp.n == 6) temp.v = "-1 -2 -3 1 2 3";
  else if (temp.n == 7) temp.v = "1 2 3 0 0 1 0";
  else temp.v = "conf";
  temp.o.cameramode = temp.v;
  temp.w = temp.o.cameramode;
  cf("Camera.cameramode", "d=" @ temp.d @ "|w=" @ temp.w);
  temp.d = temp.o.eulerrotation;
  temp.n = temp.d.tokenize().size();
  if (temp.n == 3) temp.v = "1 2 3";
  else if (temp.n == 4) temp.v = "0.1 0.2 0.3 1";
  else if (temp.n == 6) temp.v = "-1 -2 -3 1 2 3";
  else if (temp.n == 7) temp.v = "1 2 3 0 0 1 0";
  else temp.v = "conf";
  temp.o.eulerrotation = temp.v;
  temp.w = temp.o.eulerrotation;
  cf("Camera.eulerrotation", "d=" @ temp.d @ "|w=" @ temp.w);
  temp.d = temp.o.followattachedobject;
  temp.o.followattachedobject = this.go2;
  temp.w = temp.o.followattachedobject;
  cf("Camera.followattachedobject", "d=" @ temp.d @ "|w=" @ temp.w);
  temp.d = temp.o.lookatposition;
  temp.n = temp.d.tokenize().size();
  if (temp.n == 3) temp.v = "1 2 3";
  else if (temp.n == 4) temp.v = "0.1 0.2 0.3 1";
  else if (temp.n == 6) temp.v = "-1 -2 -3 1 2 3";
  else if (temp.n == 7) temp.v = "1 2 3 0 0 1 0";
  else temp.v = "conf";
  temp.o.lookatposition = temp.v;
  temp.w = temp.o.lookatposition;
  cf("Camera.lookatposition", "d=" @ temp.d @ "|w=" @ temp.w);
  temp.d = temp.o.lookvector;
  temp.n = temp.d.tokenize().size();
  if (temp.n == 3) temp.v = "1 2 3";
  else if (temp.n == 4) temp.v = "0.1 0.2 0.3 1";
  else if (temp.n == 6) temp.v = "-1 -2 -3 1 2 3";
  else if (temp.n == 7) temp.v = "1 2 3 0 0 1 0";
  else temp.v = "conf";
  temp.o.lookvector = temp.v;
  temp.w = temp.o.lookvector;
  cf("Camera.lookvector", "d=" @ temp.d @ "|w=" @ temp.w);
  temp.o.updatePosition();
  cf("Camera.updatePosition", "r=");
}
function s_TGameObjectAttr() {
  cf("at", "TGameObjectAttr");
  cf("TGameObjectAttr.@inst", "skip");
}
function ov(o) {
  if (o == NULL) return "null";
  return "obj:" @ o.name;
}
function cf(k, v) {
  triggerserver("gui", "ConfProbe", "cf", k, v);
}

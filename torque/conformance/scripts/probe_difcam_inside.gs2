// Conformance probe (T3D-030, T3D-087): hold the camera inside room A (zone 1) of
// our generated house (world 0 13.5 1.5, looking +y at the middle wall and
// its doorway into room B, zone 2) so the screenshot shows what is drawn
// through the A-B doorway. The house GameObject stands at 0 12 0 (tools/dif/difgen.py house()).
//#CLIENTSIDE
function onCreated() {
  this.n = 0;
  setTimer(1);
}
function onTimeout() {
  temp.cam = ServerConnection.camera;
  if (temp.cam == NULL) {
    cf("cam", "0");
  } else {
    temp.cam.cameramode = "free";
    temp.cam.position = "0 13.5 1.5";
    temp.cam.eulerrotation = "0 0 0";
    temp.cam.updatePosition();
    this.n++;
    if (this.n == 8) {
      cf("cam", "1");
      cf("cam_pos", temp.cam.position);
    }
  }
  setTimer(0.25);
}
function cf(k, v) {
  triggerserver("gui", "ConfProbe", "cf", k, v);
}

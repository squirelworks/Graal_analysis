  temp.o.showFrame = true;
  temp.w = temp.o.showFrame;
  temp.o.showFrame = "zz";
  temp.j = temp.o.showFrame;
  temp.o.showFrame = temp.d;
  cf("GuiShapeNameHud.showFrame", "d=" @ temp.d @ "|w=" @ temp.w @ "|j=" @ temp.j);
  temp.d = temp.o.verticalOffset;
  temp.o.verticalOffset = 0.5;
  temp.w = temp.o.verticalOffset;
  temp.o.verticalOffset = "zz";
  temp.j = temp.o.verticalOffset;
  temp.o.verticalOffset = temp.d;
  cf("GuiShapeNameHud.verticalOffset", "d=" @ temp.d @ "|w=" @ temp.w @ "|j=" @ temp.j);
  temp.d = temp.o.distanceFade;
  temp.o.distanceFade = 0.5;
  temp.w = temp.o.distanceFade;
  temp.o.distanceFade = "zz";
  temp.j = temp.o.distanceFade;
  temp.o.distanceFade = temp.d;
  cf("GuiShapeNameHud.distanceFade", "d=" @ temp.d @ "|w=" @ temp.w @ "|j=" @ temp.j);
}
function ov(o) {
  if (o == NULL) return "null";
  return "obj:" @ o.name;
}
function cf(k, v) {
  triggerserver("gui", "ConfProbe", "cf", k, v);
}

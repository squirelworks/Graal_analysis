// Original NPC library: chest that opens to a spoken word
// Category: object / chests
// Image: chest sheet as in chest-rupees.gs1
// Events: playerenters, playertouchsme, playerchats
// Flag set: chest_riddle (rename per chest)
//
// Touching it gives a riddle. Saying the answer (in chat) while standing
// within three tiles opens it and pays out.

if (playerenters) {
  if (chest_riddle) {
    setimgpart chest.png,32,0,32,32;
  } else {
    setimgpart chest.png,0,0,32,32;
  }
}

if (playertouchsme && !chest_riddle) {
  say2 I have keys but open no locks.#bSay my name.;
}

if (playerchats && !chest_riddle && strequals(#c,piano)) {   // <- answer, one word
  if (abs(playerx - x) < 3 && abs(playery - y) < 3) {
    set chest_riddle;
    setimgpart chest.png,32,0,32,32;
    play chest.wav;
    playerrupees += 100;
    say2 The lid clicks open: 100 rupees!;
  }
}

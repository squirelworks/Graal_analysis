// Original NPC library: basic sign
// Category: object / signs
// Image: any sign picture, e.g. a 32x32 board (set below)
// Events: playerenters, playertouchsme
//
// Shows one line of text when the player walks up to it facing it.
// Change the image and the text in the two marked lines.

if (playerenters) {
  setimg sign.png;            // <- image
}

// Read only when the player faces up at the sign (direction 0).
if (playertouchsme && playerdir == 0) {
  say2 Mill Road - the bridge to the east is out.;   // <- text
}

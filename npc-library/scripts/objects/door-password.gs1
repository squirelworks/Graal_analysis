// Original NPC library: password gate
// Category: object / doors
// Image: a gate
// Events: playerenters, playertouchsme, playerchats, timeout
//
// The gate asks for the word when touched. If a player near it says the
// word, the gate opens for five seconds. Nothing is stored, so the word is
// needed every visit.

if (playerenters) {
  setimg gate.png;
  timereverywhere;
  this.open = 0;
}

if (playertouchsme && this.open == 0) {
  say2 Halt! What is the password?;
}

if (playerchats && this.open == 0 && strequals(#c,swordfish)) {   // <- password
  if (abs(playerx - x) < 4 && abs(playery - y) < 4) {
    this.open = 1;
    hide;
    timeout = 5;
  }
}

if (timeout && this.open == 1) {
  this.open = 0;
  show;
}

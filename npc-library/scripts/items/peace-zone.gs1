// Original NPC library: weapon-free zone
// Category: combat / weapons (zones)
// Image: none (invisible)
// Events: playerenters, timeout
//
// Disables the player's weapons while they are inside a rectangle of the
// level (a town square, a shrine) and enables them again as soon as they
// step out. Checks four times a second. Leaving the level with weapons off
// is avoided by turning them on again whenever the player is outside.

if (playerenters) {
  timereverywhere;
  hide;
  this.x1 = 16; this.y1 = 16;   // <- top-left of the zone
  this.x2 = 48; this.y2 = 40;   // <- bottom-right
  this.inside = 0;
  timeout = 0.25;
}

if (timeout) {
  this.fx = playerx + 1.5;
  this.fy = playery + 2;
  this.now = 0;
  if (this.fx >= this.x1 && this.fx < this.x2 && this.fy >= this.y1 && this.fy < this.y2) this.now = 1;
  if (this.now == 1 && this.inside == 0) {
    disableweapons;
    setplayerprop #c,(weapons put away);
  }
  if (this.now == 0 && this.inside == 1) {
    enableweapons;
  }
  this.inside = this.now;
  timeout = 0.25;
}

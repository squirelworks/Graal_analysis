// Original NPC library: weapon-free zone
// Category: combat / weapons (zones)
// Image: none (invisible)
// Events: playerenters, timeout
//
// Disables the player's weapons while they are inside a rectangle of the
// level (a town square, a shrine) and enables them again as soon as they
// step out. Checks ten times a second.
// Place the zone well away from level links and warps. The zone can only
// turn weapons back on while the player is still in this level, so leaving
// from inside it (a warp, a link, dying) keeps weapons off in the next
// levels, and the server saves that to the account (lab run, 2026-11-04).
// Any later NPC that calls enableweapons undoes it.

if (playerenters) {
  timereverywhere;
  hide;
  enableweapons;
  this.x1 = 16; this.y1 = 16;   // <- top-left of the zone
  this.x2 = 48; this.y2 = 40;   // <- bottom-right
  this.inside = 0;
  timeout = 0.1;
}

if (timeout) {
  this.fx = playerx + 1.5;
  this.fy = playery + 2;
  this.now = 0;
  if (this.fx >= this.x1 && this.fx < this.x2 && this.fy >= this.y1 && this.fy < this.y2) this.now = 1;
  if (this.now == 1 && this.inside == 0) {
    disableweapons;
    setplayerprop #c,(weapons put away);
  }
  if (this.now == 0 && this.inside == 1) {
    enableweapons;
  }
  this.inside = this.now;
  timeout = 0.1;
}

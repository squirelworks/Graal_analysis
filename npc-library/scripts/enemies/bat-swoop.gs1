// Original NPC library: swooping bat
// Category: combat / baddies
// Image: bat sheet, wings up at x 0 and down at x 32, 32x32
// Events: playerenters, playertouchsme, washit, wasshot, timeout
//
// Flutters in a small circle around its roost. When the player comes
// within five tiles it swoops at where the player was at that moment,
// then flutters back up. Flaps by swapping two frames. One hit kills.

if (playerenters) {
  setimgpart bat.png,0,0,32,32;
  dontblock;
  drawoverplayer;
  this.rx = x;
  this.ry = y;
  this.a = 0;
  this.mode = 0;              // 0 circling, 1 swooping, 2 returning
  this.alive = 1;
  this.flap = 0;
  timeout = 0.05;
}

if (playertouchsme && this.alive == 1) hurt 1;

if ((washit || wasshot) && this.alive == 1) {
  this.alive = 0;
  putleaps 4,x,y;
  hide;
}

if (timeout && this.alive == 1) {
  this.flap++;
  if (this.flap % 4 == 0) setimgpart bat.png,0,0,32,32;
  if (this.flap % 4 == 2) setimgpart bat.png,32,0,32,32;
  if (this.mode == 0) {
    this.a += 0.15;
    x = this.rx + cos(this.a) * 1.5;
    y = this.ry + sin(this.a) * 1;
    if (abs(playerx - x) < 5 && abs(playery - y) < 5) {
      this.mode = 1;
      this.tx = playerx + 0.5;
      this.ty = playery + 1;
    }
  } else {
    if (this.mode == 1) { this.gx = this.tx; this.gy = this.ty; } else { this.gx = this.rx; this.gy = this.ry; }
    this.ddx = this.gx - x;
    this.ddy = this.gy - y;
    this.len = (this.ddx ^ 2 + this.ddy ^ 2) ^ 0.5;
    if (this.len < 0.4) {
      if (this.mode == 1) this.mode = 2; else this.mode = 0;
    } else {
      x += this.ddx / this.len * 0.4;
      y += this.ddy / this.len * 0.4;
    }
  }
  timeout = 0.05;
}

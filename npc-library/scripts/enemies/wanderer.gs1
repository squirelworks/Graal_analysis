// Original NPC library: wanderer
// Category: combat / weapons (AI), combat / baddies
// Image: a 32x32 creature
// Events: playerenters, playertouchsme, washit, wasshot, timeout
//
// Roams inside a rectangle around where it was placed. Every one to three
// seconds it picks a new direction and speed; it turns round when the next
// step would hit a wall or leave the rectangle. Touch hurts; two hits kill.

function newcourse() {
  this.dir = int(random(0,4));
  this.speed = random(0.1,0.3);
  this.turn = random(1,3);
}

if (playerenters) {
  setimg beetle.png;
  this.minx = x - 6;          // <- roaming box, in tiles around the start
  this.maxx = x + 6;
  this.miny = y - 4;
  this.maxy = y + 4;
  this.hp = 2;
  this.alive = 1;
  newcourse();
  timeout = 0.05;
}

if (playertouchsme && this.alive == 1) hurt 1;

if ((washit || wasshot) && this.alive == 1) {
  this.hp--;
  play hit.wav;
  newcourse();
  if (this.hp <= 0) {
    this.alive = 0;
    putleaps 4,x,y;
    hide;
  }
}

if (timeout && this.alive == 1) {
  this.dx = 0;
  this.dy = 0;
  if (this.dir == 0) this.dy = -this.speed;
  if (this.dir == 1) this.dx = -this.speed;
  if (this.dir == 2) this.dy = this.speed;
  if (this.dir == 3) this.dx = this.speed;
  this.nx = x + this.dx;
  this.ny = y + this.dy;
  if (this.nx < this.minx || this.nx > this.maxx || this.ny < this.miny || this.ny > this.maxy
      || onwall(this.nx, this.ny) || onwall(this.nx + 1.9, this.ny + 1.9)) {
    this.dir = (this.dir + 2) % 4;      // turn round
  } else {
    x = this.nx;
    y = this.ny;
  }
  this.turn -= 0.05;
  if (this.turn <= 0) newcourse();
  timeout = 0.05;
}

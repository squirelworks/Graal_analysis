// Original NPC library: trap disarmed by a password
// Category: combat / hazards
// Image: a pressure plate with a skull mark
// Events: playerenters, playertouchsme, playerchats
// Flag set: trap_tomb_safe (rename per trap)
//
// Burns anyone who steps on it, until someone standing near it says the
// word. Then it shows as safe and stays disarmed for that player.

if (playerenters) {
  dontblock;
  drawunderplayer;
  if (trap_tomb_safe) {
    setimg plate_safe.png;
  } else {
    setimg plate_skull.png;
  }
}

if (playertouchsme && !trap_tomb_safe) {
  putexplosion 1,x+0.5,y+0.5;
  hurt 2;
}

if (playerchats && !trap_tomb_safe && strequals(#c,peace)) {   // <- password
  if (abs(playerx - x) < 5 && abs(playery - y) < 5) {
    set trap_tomb_safe;
    setimg plate_safe.png;
    play secret.wav;
  }
}

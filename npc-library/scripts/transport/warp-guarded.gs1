// Original NPC library: warp that needs permission
// Category: transport / level-warps
// Image: a portal or a cave mouth
// Events: playerenters, playertouchsme, timeout
// Flag read: pass_mountain (rename to suit)
//
// Warps only a player who has the flag; others are pushed back a tile and
// told why. The push uses the stored approach direction so the player is
// not stuck in a loop of touches. The message is shown at most every two
// seconds.

if (playerenters) {
  timereverywhere;            // every client runs its own cool-down
  setimg portal.png;
  dontblock;
  drawunderplayer;
  this.cool = 0;
}

if (playertouchsme) {
  if (pass_mountain) {
    setlevel2 mountain_pass.graal,32,60;  // <- destination
  } else if (this.cool == 0) {
    this.cool = 1;
    timeout = 2;
    // step back the way the player came (playerdir 0 up, 2 down)
    if (playerdir == 0 && !onwall(playerx + 1.5, playery + 3.5)) {
      playery += 1;
    } else if (playerdir == 2 && !onwall(playerx + 1.5, playery + 1)) {
      playery -= 1;
    }
    say2 The guard's seal is missing. You may not pass.;
  }
}

if (timeout) {
  this.cool = 0;
}
